{
  "compilerOptions": {
    "checkJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["es2025"],
    "module": "node20",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "strict": true,
    "target": "es2025",
    "types": ["node"]
  },
  "include": ["src/**/*.js", "test/**/*.js"]
}
