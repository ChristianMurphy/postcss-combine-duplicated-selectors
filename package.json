{
  "name": "postcss-combine-duplicated-selectors",
  "version": "11.0.0",
  "description": "automatically keep css selectors unique",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.d.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "commit": "commit",
    "format": "oxfmt",
    "bench": "node --experimental-bench --bench bench/frameworks.js",
    "bench:removed": "node bench/removed.js",
    "build": "node node_modules/typescript/bin/tsc --build --clean && node node_modules/typescript/bin/tsc --build && type-coverage",
    "fuzz": "node --test test/cascade.js test/properties.js test/selector-soundness.js",
    "prepack": "npm run build",
    "test": "run-s test:*",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"test/**/*.js\"",
    "test:lint-js": "oxlint",
    "test:format": "oxfmt --check",
    "test:lint-md": "remark *.md -q --no-stdout",
    "commitlint": "commitlint --from HEAD~1",
    "prepare": "husky",
    "test:types": "npm run build"
  },
  "keywords": [
    "postcss-plugin",
    "selector"
  ],
  "author": {
    "name": "Christian Murphy",
    "email": "christian.murphy.42@gmail.com",
    "url": "https://github.com/ChristianMurphy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChristianMurphy/postcss-combine-duplicated-selectors.git"
  },
  "homepage": "https://github.com/ChristianMurphy/postcss-combine-duplicated-selectors",
  "bugs": {
    "url": "https://github.com/ChristianMurphy/postcss-combine-duplicated-selectors/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "postcss": "^8.1.0"
  },
  "dependencies": {
    "postcss-selector-parser": "^7.0.0",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@commitlint/prompt-cli": "21.2.3",
    "@types/node": "24.19.1",
    "css-select": "7.0.0",
    "domhandler": "6.0.1",
    "fast-check": "4.10.2",
    "husky": "9.1.7",
    "npm-run-all2": "9.0.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "postcss": "8.5.28",
    "postcss-nested": "8.0.1",
    "postcss-scss": "4.0.9",
    "remark-cli": "12.0.1",
    "remark-preset-lint-consistent": "6.0.1",
    "remark-preset-lint-recommended": "7.0.1",
    "remark-validate-links": "13.1.0",
    "type-coverage": "2.30.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "remarkConfig": {
    "plugins": [
      "preset-lint-recommended",
      "preset-lint-consistent",
      "validate-links"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "renovate": {
    "extends": [
      "config:recommended"
    ],
    "automerge": true,
    "major": {
      "automerge": false
    },
    "lockFileMaintenance": {
      "enabled": true
    },
    "semanticPrefix": "chore:",
    "semanticCommitScope": "",
    "packageRules": [
      {
        "matchFileNames": [
          "bench/package.json"
        ],
        "groupName": "benchmark frameworks",
        "automerge": false
      }
    ]
  },
  "overrides": {
    "type-coverage-core": {
      "typescript": "npm:@typescript/typescript6@^6"
    }
  },
  "typeCoverage": {
    "atLeast": 100,
    "detail": true,
    "ignoreNested": true,
    "strict": true
  }
}
